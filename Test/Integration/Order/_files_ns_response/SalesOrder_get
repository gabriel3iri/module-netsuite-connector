<?php
if (!isset($success)) {
    throw new \Exception(sprintf('file %s missing $success', __FILE__));
}

$response = new \NetSuite\Classes\GetResponse();
$response->readResponse = new \NetSuite\Classes\ReadResponse();
$response->readResponse->status = new \NetSuite\Classes\Status();

if ($success) {
    if (!isset($netsuiteId)) {
        throw new \Exception(sprintf('file %s missing $netsuiteId', __FILE__));
    }

    $response->readResponse->status->isSuccess = true;
    $response->readResponse->record = new \NetSuite\Classes\SalesOrder();
    $response->readResponse->record->internalId = $netsuiteId;
} else {
    $response->readResponse->status->isSuccess = false;
    $response->readResponse->status->statusDetail = [];
    $response->readResponse->status->statusDetail[0] = new \NetSuite\Classes\StatusDetail();
    $response->readResponse->status->statusDetail[0]->code = \NetSuite\Classes\StatusDetailCodeType::RCRD_DSNT_EXIST;
}

return $response;
